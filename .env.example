# Copy to .env and adjust as needed. Never commit the real .env.

# Local development: the app runs on the host, Postgres runs in Docker.
DATABASE_URL=postgres://habit:habit@localhost:5432/habit_tracker

# Used by docker compose. Both default to the local-only dev credentials.
# DB_PASSWORD=change-me
# DB_BIND=127.0.0.1
# DB_PORT=5432
# APP_BIND=127.0.0.1
# APP_PORT=3000
